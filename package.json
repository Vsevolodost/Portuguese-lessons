{
  "name": "bora-portugues-pilot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.cjs",
    "test": "node check.cjs && node --test server.test.cjs chat.test.cjs courses.test.cjs audio.test.cjs account.test.cjs config.test.cjs vercel.test.cjs placement.test.cjs practice.test.cjs azure-speech.test.cjs live.test.cjs study.test.cjs",
    "build:auth": "esbuild scripts/supabase-browser.js --bundle --format=iife --minify --outfile=dist/supabase-vendor.js",
    "build:live": "esbuild scripts/gemini-browser.js --bundle --format=iife --minify --outfile=dist/gemini-vendor.js"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "node-edge-tts": "1.2.12"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
