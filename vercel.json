{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node check.cjs && npm ci --prefix frontend && node scripts/build-course-frontend.cjs && npm run build --prefix frontend && node scripts/package-frontend.cjs",
  "outputDirectory": "dist",
  "regions": [
    "dub1"
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 240,
      "includeFiles": "{knowledge/chunks.jsonl,certs/russian-trusted-root.pem,supabase-public.json,dist/courses-data.js,course-content/lessons.json,dist/exam-data.js}"
    },
    "api/knowledge.js": {
      "includeFiles": "knowledge/chunks.jsonl"
    },
    "api/config.js": {
      "includeFiles": "supabase-public.json"
    },
    "api/speech.js": {
      "maxDuration": 90,
      "includeFiles": "{supabase-public.json,frontend/src/data/audio.json,dist/assets/audio/*.mp3}"
    },
    "api/transcribe.js": {
      "maxDuration": 90,
      "includeFiles": "supabase-public.json"
    },
    "api/live-session.js": {
      "maxDuration": 60,
      "includeFiles": "{supabase-public.json,dist/courses-data.js,course-content/lessons.json,knowledge/chunks.jsonl}"
    },
    "api/exam-feedback.js": {
      "maxDuration": 120,
      "includeFiles": "{supabase-public.json,dist/exam-data.js,certs/russian-trusted-root.pem}"
    },
    "api/auth.js": {
      "maxDuration": 60,
      "includeFiles": "supabase-public.json"
    },
    "api/progress.js": {
      "maxDuration": 60,
      "includeFiles": "supabase-public.json"
    },
    "api/avatar.js": {
      "maxDuration": 30,
      "includeFiles": "supabase-public.json"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/api/v1/me",
      "destination": "/api/auth?action=me"
    },
    {
      "source": "/api/v1/progress",
      "destination": "/api/progress"
    },
    {
      "source": "/learn",
      "destination": "/learn/index.html"
    },
    {
      "source": "/learn/:path*",
      "destination": "/learn/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' https://nsvnptuxnmutwvmuczjm.supabase.co https://accounts.google.com"
        }
      ]
    },
    {
      "source": "/assets/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
